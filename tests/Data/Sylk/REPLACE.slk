ID;PXL;N;EP;PGeneralP;P0P;P0.00P;P#,##0P;P#,##0.00P;P$#,##0 ;;($#,##0)P;P$#,##0.00 ;;($#,##0.00)P;P0%P;P0.00%P;P0.00E+00P;Pm/d/yyP;Pd-mmm-yyP;Pd-mmmP;Pmmm-yyP;Ph:mm AM/PMP;Ph:mm:ss AM/PMP;Ph:mmP;Ph:mm:ssP;Pm/d/yy h:mmF;P0;DG0G10;E;G;N3 10B;Y48;X2O;L;EF;W1 1 6F;W2 2 23NN;NASK;ER40C2NN;NINSIDE;ER32C2NN;NNTH;E#REF!NN;NOUTSIDE;ER30C2NN;NREPLACE;Gr;ER19C2NN;NSWAP;ER44C2F;SD;Y1C;K"This macro sheet contains a command macro that lets"F;SD;Y2C;K"you do search and replaces in formulas.  Like the Find"F;SD;Y3C;K"command from the Formula menu, it searches the entire"F;SD;Y4C;K"worksheet, or, if more than one cell is selected, just"F;SD;Y5C;K"within the selection."F;SD;Y6F;SD;Y7C;K"To run  the REPLACE macro, make a selection on a"F;SD;Y8C;K"worksheet, choose the RUN command, and select"F;SD;Y9C;K"REPLACE!REPLACE.  The REPLACE macro asks you what"F;SD;Y10C;K"to search for, what to replace with, and whether you"F;SD;Y11C;K"want to replace all occurences or just certain ones.  If"F;SD;Y12C;K"you want to replace just certain ones, the macro will"F;SD;Y13C;K"ask you about each individual occurence."F;SD;Y14;X1C;K"INDEX"F;SD;X2F;SDTLBR;Y15;X1C;K"NAME [key]"F;SDTLBR;X2C;K"DESCRIPTION"F;STLBR;Y16;X1C;K"REPLACE [r]"F;STLBR;X2C;K"Search and Replace command macro"F;SD;Y17;X1F;SDTLBR;Y18C;K"NAMES"F;SDTLBR;X2C;K"REPLACE [r]"F;STLR;Y19;X1C;K"REPLACE"F;STLR;X2C;K"54";EINPUT("Enter the text to search for.  It must not contain *.",2,"Replace")F;SLR;Y20;X1F;SLR;X2C;K#VALUE!;EIF(NOT(R[-1]C),RETURN())F;SLR;Y21;X1F;SLR;X2C;K"545";EINPUT("Enter the text to replace "&R[-2]C&" with.",2,"Replace")F;SLR;Y22;X1F;SLR;X2C;K#VALUE!;EIF(NOT(R[-1]C),RETURN())F;SLR;Y23;X1F;SLR;X2C;K2;ELEN(R[-4]C)F;SLR;Y24;X1F;SLR;X2C;K3;ELEN(R[-3]C)F;SLR;Y25;X1F;SLR;X2C;KFALSE;EINPUT("Replace all occurences of "&R[-6]C&"?  Type Y or N.",2,"Replace")F;SLR;Y26;X1C;K"If Y then TRUE, if N then FALSE, else return."F;SLR;X2C;KFALSE;EIF(R[-1]C="Y",TRUE,IF(R[-1]C<>"N",RETURN()))F;SLR;Y27;X1F;SLR;X2C;KFALSE;EIF(NOT(FORMULA.FIND(R[-8]C,1,2,1)),RETURN())F;SLR;Y28;X1F;SLR;X2C;K4;EROW(ACTIVE.CELL())F;SLR;Y29;X1F;SLR;X2C;K1;ECOLUMN(ACTIVE.CELL())F;SLR;Y30;X1C;K"OUTSIDE"F;SLR;X2C;KTRUE;ESET.VALUE(R[+3]C,-R[-6]C+1)F;SLR;Y31;X1F;SLR;X2C;KTRUE;ESET.VALUE(R[+11]C,1)F;SLR;Y32;X1C;K"INSIDE"F;SLR;X2C;K"=5545+5545+554";EGET.FORMULA(ACTIVE.CELL())F;SLR;Y33;X1C;K"Find next occurence in same formula."F;SLR;X2C;K3;ESEARCH(R[-14]C,R[-1]C,RC+R[-9]C)F;SLR;Y34;X1C;K"If no occurence in same formula then find next formula."F;SLR;X2C;KTRUE;EIF(NOT(ISERROR(R[-1]C)),IF(R[-8]C,GOTO(SWAP),GOTO(ASK)))F;SLR;Y35;X1F;SLR;X2C;KFALSE;EIF(NOT(FORMULA.FIND(R[-16]C,1,2,1)),RETURN())F;SLR;Y36;X1F;SLR;X2C;KTRUE;EIF(NOT(R[-10]C),GOTO(OUTSIDE))F;SLR;Y37;X1F;SLR;X2C;K4;EROW(ACTIVE.CELL())F;SLR;Y38;X1F;SLR;X2C;K1;ECOLUMN(ACTIVE.CELL())F;SLR;Y39;X1F;SLR;X2C;KTRUE;EIF(AND(R[-2]C=R[-11]C,R[-1]C=R[-10]C),RETURN(),GOTO(OUTSIDE))F;SLR;Y40;X1C;K"ASK"F;SLR;X2C;KFALSE;EIF(R[+2]C>1,INPUT("There it is again!  Replace?  Type Y or N.",2,"Replace"),INPUT("Replace?  Type Y or N.",2,"Replace"))F;SLR;Y41;X1C;K"If Y then replace, if N then fall through, else return."F;SLR;X2C;KTRUE;EIF(R[-1]C="Y",GOTO(SWAP),IF(R[-1]C<>"N",RETURN()))F;SLR;Y42;X1F;SLR;X2C;K1;ERC+1F;SLR;Y43;X1C;K"FInd next occurence."F;SLR;X2C;KTRUE;EGOTO(INSIDE)F;SLR;Y44;X1C;K"SWAP"F;SLR;X2C;K21;ELEN(R[-12]C)F;SLR;Y45;X1F;SLR;X2C;K"=55455+5545+55455+5545";EMID(R[-13]C,1,R[-12]C-1)&R[-24]C&MID(R[-13]C,R[-12]C+R[-22]C,R[-1]C-R[-12]C-R[-22]C+1)F;SLR;Y46;X1F;SLR;X2C;KTRUE;EFORMULA(R[-1]C)F;SLR;Y47;X1C;K"Find next occurence."F;SLR;X2C;KTRUE;EGOTO(INSIDE)F;SLBR;Y48;X1F;SLBR;X2C;KTRUE;ERETURN()E