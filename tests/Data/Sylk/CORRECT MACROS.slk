TRUE;EMESSAGE(FALSE)F;SLR;X2C;K"Cleans up and displays alert box"C;X4;K0F;SLR;Y16;X1C;KTRUE;EDATA.FIND(FALSE)F;SLR;X2C;X4;K0F;SLR;Y17;X1C;KTRUE;ESELECT(INDEX(!database,0,10))F;SLR;X2C;K"Select column of calculated values"C;X4;K0F;SLR;Y18;X1C;KTRUE;EALERT("All done",2)F;SLR;X2C;X4;K0F;SLBR;Y19;X1C;KTRUE;ERETURN()F;SLBR;X2F;STL;X3C;K"Row"F;STR;X4C;K27F;SLB;Y20;X3C;K"LastRow"F;SBR;X4C;K26F;SDTLBR;Y21;X1C;K"First Row"F;SITLB;Y22C;K"Gets time and average from FirstBase and LastBase (also checks LastBase to see if we're done yet)"F;STLR;Y23C;KTRUE;ESET.NAME("FirstBase",LastBase)F;STLR;X2F;SLR;Y24;X1C;KTRUE;ESET.VALUE(Ta,Tc)F;SLR;X2C;K"Set Ta to contents of cell in Time column"F;SLR;Y25;X1C;KTRUE;ESET.VALUE(Ga,Gc)F;SLR;X2C;K"Set Ga to contents of cell in Average column"F;SLR;Y26;X1C;KTRUE;ESELECT(LastBase)F;SLR;X2F;SLR;Y27;X1C;KTRUE;EDATA.FIND.NEXT()F;SLR;X2C;K"Find last base row"F;SLR;Y28;X1C;KTRUE;ESET.NAME("LastBase",SELECTION())F;SLR;X2C;K"Get time and average from last base:"F;SLR;Y29;X1C;KTRUE;ESET.VALUE(Tc,INDEX(LastBase,3))F;SLR;X2C;K"Set Tc to contents of cell in Time column"F;SLR;Y30;X1C;KTRUE;ESET.VALUE(Gc,INDEX(LastBase,9))F;SLR;X2C;K"Set Gc to contents of cell"F;SLR;Y31;X1C;KTRUE;EIF(ROW(LastBase)<=ROW(FirstBase),RETURN(FALSE))F;SLR;X2C;K"Test for end"F;SLBR;Y32;X1C;KTRUE;ERETURN(TRUE)F;SLBR;X2F;SDTLBR;Y34;X1C;K"Get.BSR"F;SITLB;Y35C;K"Calculates Base Station Reading at given time"F;SB;X2F;SLR;Y36;X1C;KTRUE;EARGUMENT("Tb",1)F;SLR;X2C;K"Reads in time as a number"F;SLR;Y37;X1C;K3080.2121570801;E((Tc-Tb)*(Ga-Gc)/(Tc-Ta))+GcF;SLR;X2C;K"Calculuates BSR"F;SLR;Y38;X1C;KTRUE;ERESULT(1)F;SLR;X2C;K"Result is a number"F;SLBR;Y39;X1C;KTRUE;ERETURN(R[-2]C)F;SLBR;X2C;K"Returns BSR"F;SDTLBR;Y41;X1C;K"Write.BSR"F;SITLB;Y42C;K"Uses Get.BSR to calculate BSR, writes out to database"F;STLR;Y43C;KTRUE;ESET.VALUE(Row,ROW(FirstBase)+1)F;STLR;X2C;K"Set counter and stop value"F;SLR;Y44;X1C;KTRUE;ESET.VALUE(LastRow,ROW(LastBase)-1)F;SLR;X2F;SLR;Y45;X1C;KTRUE;ESELECT(INDEX(FirstBase,10))F;SLR;X2C;K"Select BSR cell in first station"F;SLR;Y46;X1C;K"loop "F;SLR;X2C;K"Loop gets BSR and moves down a row"F;SLR;Y47;X1C;KTRUE;ESELECT("R[1]C")F;SLR;X2C;K"Select same cell in next row"F;SLR;Y48;X1C;KFALSE;EGet.BSR(OFFSET(SELECTION(),0,-7))F;SLR;X2C;K"Calculate BSR "F;SLR;Y49;X1C;KTRUE;EFORMULA(R[-1]C)F;SLR;X2F;SLR;Y50;X1C;KTRUE;ESET.VALUE(Row,Row+1)F;SR;X2C;K"Increment counter"F;SLR;Y51;X1C;KFALSE;EIF(Row<=LastRow,GOTO(loop))F;SLR;X2C;K"If past stop value, return"F;SLBR;Y52;X1C;KTRUE;ERETURN()F;SLBR;X2E