LR;Y20;X1F;P0;FG0G;SLR;X2C;K#VALUE!;EIF(NOT(R[-1]C),RETURN())F;P0;FG0G;SLR;Y21;X1F;P0;FG0G;SLR;X2C;K"545";EINPUT("Enter the text to replace "&R[-2]C&" with.",2,"Replace")F;P0;FG0G;SLR;Y22;X1F;P0;FG0G;SLR;X2C;K#VALUE!;EIF(NOT(R[-1]C),RETURN())F;P0;FG0G;SLR;Y23;X1F;P0;FG0G;SLR;X2C;K2;ELEN(R[-4]C)F;P0;FG0G;SLR;Y24;X1F;P0;FG0G;SLR;X2C;K3;ELEN(R[-3]C)F;P0;FG0G;SLR;Y25;X1F;P0;FG0G;SLR;X2C;KFALSE;EINPUT("Replace all occurences of "&R[-6]C&"?  Type Y or N.",2,"Replace")F;P0;FG0G;SLR;Y26;X1C;K"If Y then TRUE, if N then FALSE, else return."F;P0;FG0G;SLR;X2C;KFALSE;EIF(R[-1]C="Y",TRUE,IF(R[-1]C<>"N",RETURN()))F;P0;FG0G;SLR;Y27;X1F;P0;FG0G;SLR;X2C;KFALSE;EIF(NOT(FORMULA.FIND(R[-8]C,1,2,1)),RETURN())F;P0;FG0G;SLR;Y28;X1F;P0;FG0G;SLR;X2C;K4;EROW(ACTIVE.CELL())F;P0;FG0G;SLR;Y29;X1F;P0;FG0G;SLR;X2C;K1;ECOLUMN(ACTIVE.CELL())F;P0;FG0G;SLR;Y30;X1C;K"OUTSIDE"F;P0;FG0G;SLR;X2C;KTRUE;ESET.VALUE(R[+3]C,-R[-6]C+1)F;P0;FG0G;SLR;Y31;X1F;P0;FG0G;SLR;X2C;KTRUE;ESET.VALUE(R[+11]C,1)F;P0;FG0G;SLR;Y32;X1C;K"INSIDE"F;P0;FG0G;SLR;X2C;K"=5545+5545+554";EGET.FORMULA(ACTIVE.CELL())F;P0;FG0G;SLR;Y33;X1C;K"Find next occurence in same formula."F;P0;FG0G;SLR;X2C;K3;ESEARCH(R[-14]C,R[-1]C,RC+R[-9]C)F;P0;FG0G;SLR;Y34;X1C;K"If no occurence in same formula then find next formula."F;P0;FG0G;SLR;X2C;KTRUE;EIF(NOT(ISERROR(R[-1]C)),IF(R[-8]C,GOTO(SWAP),GOTO(ASK)))F;P0;FG0G;SLR;Y35;X1F;P0;FG0G;SLR;X2C;KFALSE;EIF(NOT(FORMULA.FIND(R[-16]C,1,2,1)),RETURN())F;P0;FG0G;SLR;Y36;X1F;P0;FG0G;SLR;X2C;KTRUE;EIF(NOT(R[-10]C),GOTO(OUTSIDE))F;P0;FG0G;SLR;Y37;X1F;P0;FG0G;SLR;X2C;K4;EROW(ACTIVE.CELL())F;P0;FG0G;SLR;Y38;X1F;P0;FG0G;SLR;X2C;K1;ECOLUMN(ACTIVE.CELL())F;P0;FG0G;SLR;Y39;X1F;P0;FG0G;SLR;X2C;KTRUE;EIF(AND(R[-2]C=R[-11]C,R[-1]C=R[-10]C),RETURN(),GOTO(OUTSIDE))F;P0;FG0G;SLR;Y40;X1C;K"ASK"F;P0;FG0G;SLR;X2C;KFALSE;EIF(R[+2]C>1,INPUT("There it is again!  Replace?  Type Y or N.",2,"Replace"),INPUT("Replace?  Type Y or N.",2,"Replace"))F;P0;FG0G;SLR;Y41;X1C;K"If Y then replace, if N then fall through, else return."F;P0;FG0G;SLR;X2C;KTRUE;EIF(R[-1]C="Y",GOTO(SWAP),IF(R[-1]C<>"N",RETURN()))F;P0;FG0G;SLR;Y42;X1F;P0;FG0G;SLR;X2C;K1;ERC+1F;P0;FG0G;SLR;Y43;X1C;K"FInd next occurence."F;P0;FG0G;SLR;X2C;KTRUE;EGOTO(INSIDE)F;P0;FG0G;SLR;Y44;X1C;K"SWAP"F;P0;FG0G;SLR;X2C;K21;ELEN(R[-12]C)F;P0;FG0G;SLR;Y45;X1F;P0;FG0G;SLR;X2C;K"=55455+5545+55455+5545";EMID(R[-13]C,1,R[-12]C-1)&R[-24]C&MID(R[-13]C,R[-12]C+R[-22]C,R[-1]C-R[-12]C-R[-22]C+1)F;P0;FG0G;SLR;Y46;X1F;P0;FG0G;SLR;X2C;KTRUE;EFORMULA(R[-1]C)F;P0;FG0G;SLR;Y47;X1C;K"Find next occurence."F;P0;FG0G;SLR;X2C;KTRUE;EGOTO(INSIDE)F;P0;FG0G;SLBR;Y48;X1F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()E