0G;SLR;X2C;K"Append record in form to end of database."F;P0;FG0G;SL;X3C;K"  INFORMATION, TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y8;X1C;K"CREATE.FORM [C]"F;P0;FG0G;SLR;X2C;K"Create form."F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y9;X1C;K"DELETE [d]"F;P0;FG0G;SLR;X2C;K"Delete specified Record # from database."F;P0;FG0G;SL;X3C;K"  AT ONE POINT DURING THE DEMO, IT ASKS YOU TO ENTER SOME INFORMATION INTO A DIALOG"F;P0;FG0G;SLR;Y10;X1C;K"DEMO [D]"F;P0;FG0G;SLR;X2C;K"Automatic demonstration of macros."F;P0;FG0G;SL;X3C;K"  BOX, AND TELLS YOU EXACTLY WHAT TO DO.  OTHER THAN ENTERING THIS INFORMATION AND"F;P0;FG0G;SLR;Y11;X1C;K"FIND.NUMBER [N]"F;P0;FG0G;SLR;X2C;K"Display specified Record # database in form."F;P0;FG0G;SL;X3C;K"  TYPING Option-Command-c, PLEASE DON'T DO ANYTHING;; DON'T TYPE ANYTHING OR CLICK ON"F;P0;FG0G;SLR;Y12;X1C;K"HELP [h]"F;P0;FG0G;SLR;X2C;K"Display index of command macros."F;P0;FG0G;SL;X3C;K"  ANYTHING WITH THE MOUSE.  WHEN THE DEMO IS OVER, YOU CAN TYPE AND CLICK TO YOUR"F;P0;FG0G;SLR;Y13;X1C;K"NEXT [g]"F;P0;FG0G;SLR;X2C;K"Find next Record # and display in form."F;P0;FG0G;SL;X3C;K"  HEART'S CONTENT."F;P0;FG0G;SLR;Y14;X1C;K"NEXT.MATCH [f]"F;P0;FG0G;SLR;X2C;K"Find previous record matching criteria and display in form."F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y15;X1C;K"PREVIOUS [G]"F;P0;FG0G;SLR;X2C;K"Find previous Record # and display in form."F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y16;X1C;K"PREVIOUS.MATCH [F]"F;P0;FG0G;SLR;X2C;K"Find next record matching criteria and display in form."F;P0;FG0G;SL;X3C;K"  NOW, ABOUT THE MACROS ON THE DB.FORM MACRO SHEET.  THESE ALLOW YOU TO FIND,"F;P0;FG0G;SLBR;Y17;X1C;K"REPLACE [r]"F;P0;FG0G;SLBR;X2C;K"Replace specified Record # in database with record in form."F;P0;FG0G;SL;X3C;K"  EDIT, ADD, AND DELETE RECORDS IN A DATABASE USING A FORM, RATHER THAN WORKING"F;P0;FG0G;S;Y18;X1F;P0;FG0G;S;X2F;P0;FG0G;SL;X3C;K"  DIRECTLY WITH THE DATABASE ITSELF.  NEXT, THE DEMO WILL CREATE A SAMPLE DATABASE"F;P0;FG0G;SDTLBR;Y19;X1C;K"HELP"F;P0;FG0G;SDTLBR;X2C;K"DEMO.NEXT"F;P0;FG0G;SL;X3C;K"  RANGE."F;P0;FG0G;SLR;Y20;X1C;KTRUE;EECHO(FALSE)F;P0;FG0G;STLR;X2C;KTRUE;ESET.NAME("demo.cont",OFFSET(CALLER(),1,0))F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y21;X1C;KTRUE;EACTIVATE("DB.FORM")F;P0;FG0G;SLR;X2C;KTRUE;EECHO(FALSE)F;P0;FG0G;SL;X3C;K"  ONCE YOU HAVE CREATED AND DEFINED A DATABASE, USING THE SET DATABASE COMMAND,"F;P0;FG0G;SLR;Y22;X1C;K2;ESIZE(498,296)+MOVE(7,42)F;P0;FG0G;SLR;X2C;KTRUE;EACTIVATE("DB.FORM")F;P0;FG0G;SL;X3C;K"  THE "CREATE.FORM" MACRO ON DB.FORM CREATES A FORM IN WHICH TO DISPLAY DATABASE"F;P0;FG0G;SLR;Y23;X1C;KTRUE;EHSCROLL(COLUMN(INDEX)/256)F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("demo.row",demo.row+5)F;P0;FG0G;SL;X3C;K"  RECORDS.  NEXT, THE DEMO WILL RUN THIS MACRO, JUST AS YOU WOULD."F;P0;FG0G;SLR;Y24;X1C;KTRUE;EVSCROLL(ROW(INDEX)/16384)F;P0;FG0G;SLR;X2C;K4;EHSCROLL(demo.col/256)+VSCROLL(demo.row/16384)+MOVE(7,42)+SIZE(498,84)F;P0;FG0G;SL;X3F;P0;FG0G;SLBR;Y25;X1C;KTRUE;ERETURN()F;P0;FG0G;SLR;X2C;KTRUE;EACTIVATE(database)F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SDTLBR;Y26;X1C;K"REPLACE"F;P0;FG0G;SLR;X2C;K5;EHSCROLL(1/256)+VSCROLL(1/16384)+SELECT("R1C1")+MOVE(7,132)+SIZE(498,206)F;P0;FG0G;SL;X3C;K"  THE "CREATE.FORM" MACRO ASKS YOU TO SPECIFY THE CELLS THAT WILL CONTAIN THE FORM."F;P0;FG0G;SLR;Y27;X1C;KTRUE;EECHO(FALSE)F;P0;FG0G;SLR;X2C;KTRUE;EHALT()F;P0;FG0G;SL;X3C;K"  WHEN THE "CREATE.FORM" DIALOG BOX APPEARS, PLEASE SELECT THE RANGE OF CELLS"F;P0;FG0G;SLR;Y28;X1C;K#N/A;EGET.SELECTION()F;P0;FG0G;SDTLBR;X2C;K"DEMO"F;P0;FG0G;SL;X3C;K"  $A$1:$F$2.  IF THE DIALOG BOX COVERS THESE CELLS, YOU MAY DRAG IT."F;P0;FG0G;SLR;Y29;X1C;K#N/A;ECHECK.NUMBER()F;P0;FG0G;SLR;X2C;KTRUE;EECHO(FALSE)F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y30;X1C;K#N/A;ESELECT.RECORD()F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("demo.col",COLUMN(DEMO.TEXT))F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y31;X1C;K#N/A;EUPDATE.DATABASE()F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("demo.row",ROW(DEMO.TEXT)+1)F;P0;FG0G;SL;X3C;K"  NOW YOU CAN USE THE FORM TO VIEW RECORDS FROM THE DATABASE.  SUPPOSE YOU WANTED"F;P0;FG0G;SLR;Y32;X1C;K#N/A;ERESTORE.SELECTION()F;P0;FG0G;SLR;X2C;KTRUE;EACTIVATE("DB.FORM")F;P0;FG0G;SL;X3C;K"  TO LOOK AT THE 33rd RECORD.  FIRST YOU WOULD ENTER THE NUMBER 33 IN THE CELL"F;P0;FG0G;SLBR;Y33;X1C;KTRUE;ERETURN()F;P0;FG0G;SLR;X2C;K6;ESIZE(498,216)+MOVE(7,42)+DISPLAY(TRUE,FALSE,FALSE)+SELECT(INDEX)+HSCROLL(demo.col/256)+VSCROLL(demo.row/16384)F;P0;FG0G;SL;X3C;K"  LABELED "RECORD #".  THE DEMO WILL DO THIS NEXT."F;P0;FG0G;SDTLBR;Y34;X1C;K"ADD"F;P0;FG0G;SLR;X2C;KTRUE;EECHO(TRUE)F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y35;X1C;KTRUE;EECHO(FALSE)F;P0;FG0G;SLR;X2C;KTRUE;EALERT("This is a DEMO of the DB.FORM command macros.",2)F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y36;X1C;K#N/A;EGET.SELECTION()F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("demo.cont",R[+2]C)F;P0;FG0G;SL;X3C;K"  THE "FIND.NUMBER" MACRO ON DB.FORM DISPLAYS THE SPECIFIED RECORD #.  THE DEMO WILL"F;P0;FG0G;SLR;Y37;X1C;K#N/A;ECHECK.NUMBER()F;P0;FG0G;SLR;X2C;KTRUE;EHALT()F;P0;FG0G;SL;X3C;K"  RUN THIS MACRO NEXT."F;P0;FG0G;SLR;Y38;X1C;K#N/A;ESELECT.RECORD()F;P0;FG0G;SLR;X2C;KTRUE;EECHO(FALSE)F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y39;X1C;KTRUE;EINSERT(2)F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("demo.row",demo.row+9)F;P0;FG0G;SL;X3F;P0;FG0G;SLR;Y40;X1C;KTRUE;ESELECT(OFFSET(SELECTION(),1,0))F;P0;FG0G;SLR;X2C;KTRUE;ENEW(1)F;P0;FG0G;SDL;X3C;K"                                  TYPE Option-Command-c TO CONTINUE."F;P0;FG0G;SLR;Y41;X1C;KTRUE;ECOPY()F;P0;FG0G;SLR;X2C;KTRUE;ESET.NAME("database",INDEX(WINDOWS(),1))F;P0;FG0G;S