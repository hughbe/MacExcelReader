"F;P0;FG0G;SLR;X2C;K"Scroll up one page."F;P0;FG0G;SLR;Y16;X1C;K"PASTE.SPECIAL [p]"F;P0;FG0G;SLR;X2C;K"Display the Paste Special dialog box."F;P0;FG0G;SLR;Y17;X1C;K"VALUES [v]"F;P0;FG0G;SLR;X2C;K"Convert formulas to values."F;P0;FG0G;SLR;Y18;X1C;K"AUTOMATIC  [a]"F;P0;FG0G;SLR;X2C;K"Set calculation to automatic."F;P0;FG0G;SLR;Y19;X1C;K"MANUAL  [m]"F;P0;FG0G;SLR;X2C;K"Set calculation to manual."F;P0;FG0G;SLR;Y20;X1C;K"ERRORS [E]"F;P0;FG0G;SLR;X2C;K"Find error values."F;P0;FG0G;SLR;Y21;X1C;K"LEFT.NAMES [L]"F;P0;FG0G;SLR;X2C;K"Create row names from left column, replacing any existing names."F;P0;FG0G;SLR;Y22;X1C;K"RUN [r]"F;P0;FG0G;SLR;X2C;K"Display the Run dialog box."F;P0;FG0G;SLBR;Y23;X1C;K"RUN.SELECTION [R]"F;P0;FG0G;SLBR;X2C;K"Run the macro starting at the active cell."F;P0;FG0G;S;Y24;X1F;P0;FG0G;S;X2F;P0;FG0G;SDTLBR;Y25;X1C;K"LEFT.NAMES [L]"F;P0;FG0G;SDTLBR;X2C;K"PAGE.DOWN [j]"F;P0;FG0G;STLR;Y26;X1C;K"Create row names from left column, replacing any existing names.  The ERROR(FALSE) prevents the alert box from appearing for existing names."F;P0;FG0G;STLR;X2C;K"Scroll down one page."F;P0;FG0G;SLR;Y27;X1C;KTRUE;EERROR(FALSE)F;P0;FG0G;SLR;X2C;KTRUE;EVPAGE(1)F;P0;FG0G;SLR;Y28;X1C;KTRUE;ECREATE.NAMES(FALSE,TRUE)F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLR;Y29;X1C;KTRUE;EERROR(TRUE)F;P0;FG0G;SDTLBR;X2C;K"PAGE.UP [k]"F;P0;FG0G;SLBR;Y30;X1C;KTRUE;ERETURN()F;P0;FG0G;STLR;X2C;K"Scroll up one page."F;P0;FG0G;SDTLBR;Y31;X1C;K"RUN [r]"F;P0;FG0G;SLR;X2C;KTRUE;EVPAGE(-1)F;P0;FG0G;STLR;Y32;X1C;K"Display the Run dialog box."F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLR;Y33;X1C;KFALSE;ERUN?()F;P0;FG0G;SDTLBR;X2C;K"PAGE.RIGHT [l]"F;P0;FG0G;SLBR;Y34;X1C;KTRUE;ERETURN()F;P0;FG0G;STLR;X2C;K"Scroll right one page."F;P0;FG0G;SDTLBR;Y35;X1C;K"RUN.SELECTION [R]"F;P0;FG0G;SLR;X2C;KTRUE;EHPAGE(1)F;P0;FG0G;STLR;Y36;X1C;K"Run the macro starting at the active cell.  This is particularly useful when you are writing and testing macros."F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLR;Y37;X1C;K#N/A;ERUN(ACTIVE.CELL())F;P0;FG0G;SDTLBR;X2C;K"PAGE.LEFT [h]"F;P0;FG0G;SLBR;Y38;X1C;KTRUE;ERETURN()F;P0;FG0G;STLR;X2C;K"Scroll left one page."F;P0;FG0G;SDTLBR;Y39;X1C;K"BOLD [B]"F;P0;FG0G;SLR;X2C;KTRUE;EHPAGE(-1)F;P0;FG0G;STLR;Y40;X1C;K"Set selection to Bold style.  Note that the second argument to STYLE is omitted rather than FALSE, so that the macro won't change the Italic-status."F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLR;Y41;X1C;KTRUE;ESTYLE(TRUE,)F;P0;FG0G;SDTLBR;X2C;K"PASTE.SPECIAL [p]"F;P0;FG0G;SLBR;Y42;X1C;KTRUE;ERETURN()F;P0;FG0G;STLR;X2C;K"Display the Paste Special dialog box."F;P0;FG0G;SDTLBR;Y43;X1C;K"ITALIC [I]"F;P0;FG0G;SLR;X2C;KFALSE;EPASTE.SPECIAL?()F;P0;FG0G;STLR;Y44;X1C;K"Set selection to Italic style.  Note that the first argument to STYLE is omitted rather than FALSE, so that the macro won't change the Bold-status."F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLR;Y45;X1C;KTRUE;ESTYLE(,TRUE)F;P0;FG0G;SDTLBR;X2C;K"VALUES [v]"F;P0;FG0G;SLBR;Y46;X1C;KTRUE;ERETURN()F;P0;FG0G;STLR;X2C;K"Convert formulas to values."F;P0;FG0G;SDTLBR;Y47;X1C;K"PLAIN.OVERLAY [O]"F;P0;FG0G;SLR;X2C;KTRUE;ECOPY()F;P0;FG0G;STLR;Y48;X1C;K"If worksheet, set selection to plain style;; if chart, display Overlay Chart Type dialog box.  The ISERROR(MAIN.CHART.TYPE) determines whether the active document is a worksheet or chart."F;P0;FG0G;SLR;X2C;KTRUE;EPASTE.SPECIAL(3,1)F;P0;FG0G;SLR;Y49;X1C;KTRUE;EERROR(FALSE)F;P0;FG0G;SLR;X2C;KTRUE;ECANCEL.COPY()F;P0;FG0G;SLR;Y50;X1C;KTRUE;EIF(ISERROR(MAIN.CHART.TYPE()),STYLE(FALSE,FALSE),OVERLAY.CHART.TYPE?())F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLBR;Y51;X1C;KTRUE;ERETURN()F;P0;FG0G;SDTLBR;X2C;K"ERRORS [E]"F;P0;FG0G;SDTLR;Y52;X1C;K"FORMAT.NUMBER [N]"F;P0;FG0G;STLR;X2C;K"Find error values."F;P0;FG0G;STLR;Y53;X1C;K"Display the Number dialog box."F;P0;FG0G;SLR;X2C;KTRUE;EFORMULA.FIND("#",2,2,1)F;P0;FG0G;SLR;Y54;X1C;KFALSE;EFORMAT.NUMBER?()F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLBR;Y55;X1C;KTRUE;ERETURN()F;P0;FG0G;SDTLBR;X2C;K"MANUAL [m]"F;P0;FG0G;SDTLBR;Y56;X1C;K"DOLLAR.FORMAT [d]"F;P0;FG0G;STLR;X2C;K"Sets calculation to manual."F;P0;FG0G;STLR;Y57;X1C;K"Set selection to dollar format."F;P0;FG0G;SLR;X2C;KTRUE;ECALCULATION(3,,,)F;P0;FG0G;SLR;Y58;X1C;KTRUE;EFORMAT.NUMBER("$#,##0.00 ;;($#,##0.00)")F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()F;P0;FG0G;SLBR;Y59;X1C;KTRUE;ERETURN()F;P0;FG0G;SDTLBR;X2C;K"AUTOMATIC [a]"F;P0;FG0G;S;Y60;X1F;P0;FG0G;STLR;X2C;K"Sets calculation to automatic."F;P0;FG0G;S;Y61;X1F;P0;FG0G;SLR;X2C;KTRUE;ECALCULATION(1,,,)F;P0;FG0G;S;Y62;X1F;P0;FG0G;SLBR;X2C;KTRUE;ERETURN()E